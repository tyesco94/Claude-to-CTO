{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory_load.py\"", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory_save.py\"", "timeout": 15 } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/memory_save.py\"", "timeout": 15 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Read", "hooks": [ { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/token_guard.py\"", "timeout": 10 } ] }
    ]
  }
}
